{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/reference.schema.json",
  "title": "Reference Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "publisher",
    "source_type",
    "url",
    "accessed",
    "version",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ref\\.[a-z0-9.-]+$" },
    "type": { "const": "reference_source" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["extension_guide", "research_paper", "expert_review", "regulatory_guidance"] },
    "url": { "type": "string", "format": "uri" },
    "accessed": { "type": "string", "format": "date" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["active", "superseded", "unavailable"] }
  }
}
