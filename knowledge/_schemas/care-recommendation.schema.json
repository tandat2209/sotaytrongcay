{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/care-recommendation.schema.json",
  "title": "Care Recommendation Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "locale",
    "species_ids",
    "stage_ids",
    "activity_type",
    "version",
    "status",
    "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "type": { "const": "care_recommendation_definition" },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "const": "vi-VN" },
    "species_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^plant\\.[a-z0-9-]+$" }
    },
    "stage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
    },
    "activity_type": { "enum": ["watering", "fertilizing", "spraying"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "review", "approved", "deprecated", "archived"] },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ref\\.[a-z0-9.-]+$" }
    }
  }
}
