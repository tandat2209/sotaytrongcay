{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/stage-playbook.schema.json",
  "title": "Growth Stage Playbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "locale",
    "species_id",
    "version",
    "status",
    "primary_objective",
    "entry_criteria",
    "exit_criteria",
    "estimated_duration",
    "recommended_playbook",
    "default_reminder_templates",
    "recommended_knowledge_topics",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "type": {
      "const": "growth_stage_playbook"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "species_id": {
      "type": "string",
      "pattern": "^plant\\.[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "primary_objective": {
      "type": "string",
      "minLength": 1
    },
    "entry_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_duration": {
      "type": "string"
    },
    "recommended_playbook": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "default_reminder_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_knowledge_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ref\\.[a-z0-9.-]+$"
      }
    }
  }
}
