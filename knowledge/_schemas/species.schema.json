{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/species.schema.json",
  "title": "Plant Species",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "scientific_name",
    "locale",
    "version",
    "status",
    "stage_journey",
    "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^plant\\.[a-z0-9-]+$" },
    "type": { "const": "plant_species" },
    "title": { "type": "string", "minLength": 1 },
    "scientific_name": { "type": "string", "minLength": 1 },
    "locale": { "const": "vi-VN" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "review", "approved", "deprecated", "archived"] },
    "stage_journey": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sequence", "playbook_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "playbook_status": { "enum": ["unavailable", "draft", "review", "approved"] }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ref\\.[a-z0-9.-]+$" }
    }
  }
}
