{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/species.schema.json",
  "title": "Plant Species",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "scientific_name",
    "locale",
    "version",
    "status",
    "lifecycles",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plant\\.[a-z0-9-]+$"
    },
    "type": {
      "const": "plant_species"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scientific_name": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "review", "approved", "deprecated", "archived"]
    },
    "lifecycles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "production"],
      "properties": {
        "development": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "repeatable", "initial_stage_id", "stages"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "repeatable": {
              "type": "boolean"
            },
            "initial_stage_id": {
              "type": "string"
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stage_journey_item"
              }
            }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "repeatable", "initial_stage_id", "stages"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "repeatable": {
              "type": "boolean"
            },
            "initial_stage_id": {
              "type": "string"
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stage_journey_item"
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ref\\.[a-z0-9.-]+$"
      }
    }
  },
  "$defs": {
    "stage_journey_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sequence", "playbook_status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": {
              "to": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          }
        },
        "playbook_status": {
          "enum": ["unavailable", "draft", "review", "approved"]
        }
      }
    }
  }
}
