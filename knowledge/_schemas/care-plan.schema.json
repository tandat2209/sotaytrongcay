{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/care-plan.schema.json",
  "title": "Care Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "locale",
    "priority",
    "species_ids",
    "stage_ids",
    "activity_type",
    "eligibility",
    "on_missing_history",
    "version",
    "status",
    "references",
    "title",
    "goal"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "type": {
      "const": "care_plan"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "species_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^plant\\.[a-z0-9-]+$"
      }
    },
    "stage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    },
    "activity_type": {
      "enum": [
        "watering",
        "fertilizing",
        "spraying"
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "suggest_after_days"
      ],
      "properties": {
        "kind": {
          "const": "elapsed_days_since_activity"
        },
        "suggest_after_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "on_missing_history": {
      "enum": [
        "suggest",
        "withhold"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ref\\.[a-z0-9.-]+$"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground",
        "container"
      ],
      "properties": {
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "interval_days"
          ],
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1
            },
            "interval_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "interval_days"
          ],
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1
            },
            "interval_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "recommended_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "examples"
        ],
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
