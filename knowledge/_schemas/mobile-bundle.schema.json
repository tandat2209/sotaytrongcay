{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/mobile-bundle.schema.json",
  "title": "Compiled Knowledge Bundle",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": ["1.1.0", "2.0.0", "2.1.0", "2.2.0", "2.3.0"]
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "diseases": true, "pests": true },
        "required": ["diseases", "pests"]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "properties": { "diseases": true },
              "required": ["diseases"]
            },
            {
              "properties": { "pests": true },
              "required": ["pests"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["2.2.0", "2.3.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "fertilizerGuides": true },
        "required": ["fertilizerGuides"]
      }
    }
  ],
  "required": [
    "schemaVersion",
    "contentVersion",
    "mode",
    "species",
    "stagePlaybooks",
    "carePlans",
    "guides",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "enum": ["production", "preview"]
    },
    "species": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "scientificName",
          "lifecycles",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          },
          "type": {
            "const": "plant_species"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "scientificName": {
            "type": "string",
            "minLength": 1
          },
          "lifecycles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["development", "production"],
            "properties": {
              "development": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "repeatable", "initialStageId", "stages"],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repeatable": {
                    "type": "boolean"
                  },
                  "initialStageId": {
                    "type": "string"
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/stage_journey_item"
                    }
                  }
                }
              },
              "production": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "repeatable", "initialStageId", "stages"],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repeatable": {
                    "type": "boolean"
                  },
                  "initialStageId": {
                    "type": "string"
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/stage_journey_item"
                    }
                  }
                }
              }
            }
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "stagePlaybooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "speciesId",
          "sequence",
          "lifecycleId",
          "primaryObjective",
          "entryCriteria",
          "exitCriteria",
          "estimatedDuration",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "growth_stage_playbook"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesId": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "lifecycleId": {
            "enum": ["development", "production"]
          },
          "primaryObjective": {
            "type": "string",
            "minLength": 1
          },
          "entryCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimatedDuration": {
            "type": "string"
          },
          "imageId": {
            "type": "string",
            "pattern": "^image\\.[a-z0-9.-]+$"
          },
          "recommendedKnowledgeTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "guides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "goal",
          "locale",
          "version",
          "status",
          "references",
          "speciesIds",
          "stageIds",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "care_guide"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^plant\\.[a-z0-9-]+$"
            }
          },
          "stageIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "bodyMarkdown": {
            "type": "string"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "recommendedInputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group", "examples"],
              "properties": {
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "examples": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "frequency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ground", "container"],
            "properties": {
              "ground": {
                "type": "string",
                "minLength": 1
              },
              "container": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "fertilizerGuides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "sections",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fertilizer-guide\\.[a-z0-9-]+$"
          },
          "type": { "const": "fertilizer_guide" },
          "title": { "type": "string", "minLength": 1 },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": { "$ref": "#/$defs/status" },
          "references": { "$ref": "#/$defs/references" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "items"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string", "minLength": 1 },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "name", "group", "description"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^fertilizer-role\\.[a-z0-9-]+$"
                      },
                      "name": { "type": "string", "minLength": 1 },
                      "group": {
                        "enum": [
                          "organic",
                          "nitrogen-rich",
                          "npk-balanced",
                          "phosphorus-rich",
                          "potassium-rich",
                          "support",
                          "other"
                        ]
                      },
                      "description": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "bodyMarkdown": { "type": "string" }
        }
      }
    },
    "diseases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/compiled_disease" }
    },
    "pests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/compiled_pest" }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "version",
          "status",
          "publisher",
          "sourceType",
          "url",
          "accessed",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ref\\.[a-z0-9.-]+$"
          },
          "type": {
            "const": "reference_source"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "enum": ["active", "superseded", "unavailable"]
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "enum": [
              "extension_guide",
              "research_paper",
              "expert_review",
              "regulatory_guidance"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "carePlans": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "locale",
          "priority",
          "version",
          "status",
          "references",
          "speciesIds",
          "stageIds",
          "activityType",
          "eligibility",
          "onMissingHistory",
          "title",
          "goal",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "care_plan"
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^plant\\.[a-z0-9-]+$"
            }
          },
          "stageIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "activityType": {
            "enum": ["watering", "fertilizing", "spraying"]
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "suggestAfterDays"],
            "properties": {
              "kind": {
                "const": "elapsed_days_since_activity"
              },
              "suggestAfterDays": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "onMissingHistory": {
            "enum": ["suggest", "withhold"]
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "bodyMarkdown": {
            "type": "string"
          },
          "frequency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ground", "container"],
            "properties": {
              "ground": {
                "type": "object",
                "additionalProperties": false,
                "required": ["display", "intervalDays"],
                "properties": {
                  "display": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intervalDays": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "container": {
                "type": "object",
                "additionalProperties": false,
                "required": ["display", "intervalDays"],
                "properties": {
                  "display": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intervalDays": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "recommendedInputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["catalogId", "priority"],
              "properties": {
                "catalogId": {
                  "type": "string",
                  "pattern": "^fertilizer-role\\.[a-z0-9-]+$"
                },
                "priority": { "enum": ["primary", "alternative"] }
              }
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fertilizerGroupGuidance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group", "description"],
              "properties": {
                "group": {
                  "enum": [
                    "organic",
                    "nitrogen-rich",
                    "npk-balanced",
                    "phosphorus-rich",
                    "potassium-rich",
                    "support",
                    "other"
                  ]
                },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "compiled_disease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "locale",
        "version",
        "status",
        "references",
        "speciesIds",
        "stageIds",
        "warningSignIds",
        "bodyMarkdown"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^disease\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
        },
        "type": { "const": "disease" },
        "title": { "type": "string", "minLength": 1 },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "$ref": "#/$defs/status" },
        "references": { "$ref": "#/$defs/references" },
        "speciesIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          }
        },
        "stageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "warningSignIds": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sign\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
          }
        },
        "scientificName": { "type": "string", "minLength": 1 },
        "bodyMarkdown": { "type": "string" }
      }
    },
    "compiled_pest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "locale",
        "version",
        "status",
        "references",
        "speciesIds",
        "stageIds",
        "warningSignIds",
        "bodyMarkdown"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pest\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
        },
        "type": { "const": "pest" },
        "title": { "type": "string", "minLength": 1 },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "$ref": "#/$defs/status" },
        "references": { "$ref": "#/$defs/references" },
        "speciesIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          }
        },
        "stageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "warningSignIds": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sign\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
          }
        },
        "scientificName": { "type": "string", "minLength": 1 },
        "bodyMarkdown": { "type": "string" }
      }
    },
    "status": {
      "enum": ["draft", "review", "approved", "deprecated", "archived"]
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ref\\.[a-z0-9.-]+$"
      }
    },
    "stage_journey_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sequence", "playbookStatus"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "playbookStatus": {
          "enum": ["unavailable", "draft", "review", "approved"]
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": {
              "to": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
