{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/mobile-bundle.schema.json",
  "title": "Compiled Knowledge Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "mode",
    "species",
    "stagePlaybooks",
    "careRecommendations",
    "guides",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "enum": [
        "production",
        "preview"
      ]
    },
    "species": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "scientificName",
          "lifecycles",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          },
          "type": {
            "const": "plant_species"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "scientificName": {
            "type": "string",
            "minLength": 1
          },
          "lifecycles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "development",
              "production"
            ],
            "properties": {
              "development": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "repeatable",
                  "initialStageId",
                  "stages"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repeatable": {
                    "type": "boolean"
                  },
                  "initialStageId": {
                    "type": "string"
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/stage_journey_item"
                    }
                  }
                }
              },
              "production": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "repeatable",
                  "initialStageId",
                  "stages"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repeatable": {
                    "type": "boolean"
                  },
                  "initialStageId": {
                    "type": "string"
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/stage_journey_item"
                    }
                  }
                }
              }
            }
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "stagePlaybooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "speciesId",
          "sequence",
          "lifecycleId",
          "primaryObjective",
          "entryCriteria",
          "exitCriteria",
          "estimatedDuration",
          "defaultReminderTemplates",
          "recommendedKnowledgeTopics",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "growth_stage_playbook"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesId": {
            "type": "string",
            "pattern": "^plant\\.[a-z0-9-]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "lifecycleId": {
            "enum": [
              "development",
              "production"
            ]
          },
          "primaryObjective": {
            "type": "string",
            "minLength": 1
          },
          "entryCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimatedDuration": {
            "type": "string"
          },
          "defaultReminderTemplates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendedKnowledgeTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "careRecommendations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "speciesIds",
          "stageIds",
          "activityType",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "care_recommendation_definition"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^plant\\.[a-z0-9-]+$"
            }
          },
          "stageIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "activityType": {
            "enum": [
              "watering",
              "fertilizing",
              "spraying"
            ]
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "guides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "locale",
          "version",
          "status",
          "references",
          "speciesIds",
          "stageIds",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "type": {
            "const": "care_guide"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "references": {
            "$ref": "#/$defs/references"
          },
          "speciesIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^plant\\.[a-z0-9-]+$"
            }
          },
          "stageIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "version",
          "status",
          "publisher",
          "sourceType",
          "url",
          "accessed",
          "bodyMarkdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ref\\.[a-z0-9.-]+$"
          },
          "type": {
            "const": "reference_source"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "enum": [
              "active",
              "superseded",
              "unavailable"
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "enum": [
              "extension_guide",
              "research_paper",
              "expert_review",
              "regulatory_guidance"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "bodyMarkdown": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ]
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ref\\.[a-z0-9.-]+$"
      }
    },
    "stage_journey_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sequence",
        "playbookStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "playbookStatus": {
          "enum": [
            "unavailable",
            "draft",
            "review",
            "approved"
          ]
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
