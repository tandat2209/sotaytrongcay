{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotaytrongcay.local/schemas/fertilizer-guide.schema.json",
  "title": "Focused Fertilizer Guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "locale",
    "sections",
    "version",
    "status",
    "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^fertilizer-guide\\.[a-z0-9-]+$" },
    "type": { "const": "fertilizer_guide" },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "group", "description"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^fertilizer\\.[a-z0-9-]+$"
                },
                "name": { "type": "string", "minLength": 1 },
                "group": {
                  "enum": [
                    "organic",
                    "nitrogen-rich",
                    "npk-balanced",
                    "phosphorus-rich",
                    "potassium-rich",
                    "support",
                    "other"
                  ]
                },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "enum": ["draft", "review", "approved", "deprecated", "archived"]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ref\\.[a-z0-9.-]+$" }
    }
  }
}
