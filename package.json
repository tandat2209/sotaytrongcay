{
  "name": "so-tay-trong-cay",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p scripts/knowledge/tsconfig.json --noEmit",
    "lint": "eslint .",
    "precommit": "npx lint-staged",
    "test": "jest --runInBand",
    "export": "expo export --platform all",
    "knowledge:validate": "tsx scripts/knowledge/cli.ts validate",
    "knowledge:compile": "tsx scripts/knowledge/cli.ts compile --mode production --output knowledge/_generated/mobile-bundle.json",
    "knowledge:compile:preview": "tsx scripts/knowledge/cli.ts compile --mode preview --output knowledge/_generated/mobile-bundle.preview.json",
    "knowledge:check": "tsx scripts/knowledge/cli.ts check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.16",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "lint-staged": "^16.3.4",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "gray-matter": "^4.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.32.1"
}
