{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "database-smoke": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_DATABASE_SMOKE_CHECK": "true"
      }
    }
  }
}
